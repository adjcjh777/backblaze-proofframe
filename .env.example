PROOFFRAME_STORAGE_BACKEND=local
PROOFFRAME_GENERATION_BACKEND=mock
PROOFFRAME_STORAGE_ROOT=var/storage

# Backblaze B2 S3-compatible storage. Required only for B2 mode.
B2_ENDPOINT_URL=
B2_S3_ENDPOINT_URL=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_APP_KEY=
B2_PUBLIC_BASE_URL=

# Genblaze/OpenAI-compatible media generation. Required only for Genblaze mode.
GENBLAZE_BASE_URL=http://localhost:8800/v1
GENBLAZE_API_KEY=
GENBLAZE_IMAGE_MODEL=
GMI_API_KEY=
