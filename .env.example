PROOFFRAME_STORAGE_BACKEND=local
PROOFFRAME_GENERATION_BACKEND=mock
PROOFFRAME_STORAGE_ROOT=var/storage

# Backblaze B2 S3-compatible storage. Required only for B2 mode.
B2_ENDPOINT_URL=
B2_S3_ENDPOINT_URL=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_APP_KEY=
B2_PUBLIC_BASE_URL=

# Genblaze media generation. Required only for Genblaze mode.
# Supported providers: gmicloud, openai, local.
GENBLAZE_PROVIDER=gmicloud
GENBLAZE_BASE_URL=
GENBLAZE_API_KEY=
GENBLAZE_IMAGE_MODEL=
GENBLAZE_ASPECT_RATIO=16:9
GENBLAZE_TIMEOUT_SECONDS=180
GMI_API_KEY=
OPENAI_API_KEY=
